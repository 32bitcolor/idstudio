// IDStudio — Instructional Designer Workspace
// Prisma 7 schema. Client is generated to src/generated/prisma (see generator).
// Phase 0 covers identity & tenancy only; feature models (boards, projects,
// storyboards, exams, LMS) are added in later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER // oversight role: same "see everything" board/project/etc. visibility as ADMIN, but no user/group/workspace-settings management
  MEMBER
}

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  name                    String?
  passwordHash            String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  memberships             Membership[]
  assignedCards           CardAssignee[]
  comments                Comment[]
  reviewCycles            ReviewCycle[]     @relation("ReviewReviewer")
  requestedReviews        ReviewCycle[]     @relation("ReviewRequester")
  timeEntries             TimeEntry[]
  groupMemberships        GroupMembership[]
  whiteboards             Whiteboard[]
  submittedIntakeRequests IntakeRequest[]   @relation("IntakeRequester")
  assignedIntakeRequests  IntakeRequest[]   @relation("IntakeAssignee")
}

model Workspace {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  intakeEnabled  Boolean         @default(true) // admin on/off toggle for the public intake form
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        Membership[]
  boards         Board[]
  projects       Project[]
  storyboards    Storyboard[]
  whiteboards    Whiteboard[]
  courses        Course[]
  groups         Group[]
  intakeRequests IntakeRequest[]
}

// Role is per-workspace (on Membership), never global on User.
// All authorization resolves a user's role within the workspace owning a resource.
model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ── Kanban (Phase 1) ─────────────────────────────────────────────────────────
// Ordering uses fractional-index strings (`position`): inserting between two
// items computes a key between their keys — a single-row update, no renumbering.

model Board {
  id            String       @id @default(cuid())
  workspaceId   String
  name          String
  cardKeyPrefix String? // e.g. "WP" — when set, every card created under this board (including subtasks) gets a sequential "WP-123" key
  cardKeySeq    Int          @default(0) // last card key number issued; incremented atomically on card creation
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns       Column[]
  labels        Label[]
  groupAccess   BoardGroup[]

  @@unique([workspaceId, cardKeyPrefix])
  @@index([workspaceId])
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  position  String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([boardId, position])
}

model Card {
  id           String         @id @default(cuid())
  columnId     String? // null means this card is a subtask (see parentCardId)
  parentCardId String? // set means this card IS a subtask, nested one level under another card
  title        String
  description  String? // TipTap document, stored as JSON string
  dueDate      DateTime?
  done         Boolean        @default(false) // only meaningful for subtask-cards
  keySeq       Int? // this card's number in its board's key sequence — null if the board has no cardKeyPrefix; display as "{board.cardKeyPrefix}-{keySeq}"
  position     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  column       Column?        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  parentCard   Card?          @relation("CardSubtasks", fields: [parentCardId], references: [id], onDelete: Cascade)
  subtasks     Card[]         @relation("CardSubtasks")
  labels       CardLabel[]
  assignees    CardAssignee[]
  comments     Comment[]
  attachments  Attachment[]
  deliverables Deliverable[]
  whiteboards  Whiteboard[]

  @@index([columnId, position])
  @@index([parentCardId, position])
}

model Attachment {
  id           String   @id @default(cuid())
  cardId       String
  workspaceId  String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  uploadedById String
  createdAt    DateTime @default(now())
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// ── Project management (Phase 2) ─────────────────────────────────────────────

enum Methodology {
  ADDIE
  SAM
  CUSTOM
}

model Project {
  id              String              @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  methodology     Methodology         @default(ADDIE)
  status          String              @default("active") // active / on_hold / completed
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phases          Phase[]
  deliverables    Deliverable[]
  milestones      Milestone[]
  timeEntries     TimeEntry[]
  groupAccess     ProjectGroup[]
  objectives      LearningObjective[]
  assessmentItems AssessmentItem[]
  intakeRequest   IntakeRequest?

  @@index([workspaceId])
}

model Phase {
  id           String        @id @default(cuid())
  projectId    String
  name         String
  position     String
  status       String        @default("not_started") // not_started / in_progress / done
  startDate    DateTime?
  endDate      DateTime?
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]

  @@index([projectId, position])
}

model Deliverable {
  id           String        @id @default(cuid())
  projectId    String
  phaseId      String?
  cardId       String?
  name         String
  type         String        @default("other") // storyboard / course / assessment / job_aid / video / document / other
  status       String        @default("not_started") // not_started / in_progress / in_review / complete
  position     String
  createdAt    DateTime      @default(now())
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        Phase?        @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  card         Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  reviewCycles ReviewCycle[]
  timeEntries  TimeEntry[]
  storyboard   Storyboard?
  course       Course?

  @@index([projectId, position])
}

model ReviewCycle {
  id            String      @id @default(cuid())
  deliverableId String
  reviewerId    String
  requestedById String? // who set up the review (null for legacy rows)
  round         Int
  status        String      @default("requested") // requested / in_review / changes_requested / approved
  dueDate       DateTime?
  feedback      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  reviewer      User        @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  requestedBy   User?       @relation("ReviewRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([deliverableId])
  @@index([reviewerId])
  @@index([requestedById])
}

model TimeEntry {
  id            String       @id @default(cuid())
  projectId     String
  deliverableId String?
  userId        String
  minutes       Int
  note          String?
  loggedFor     DateTime
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  dueDate     DateTime?
  completedAt DateTime?
  position    String
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

// ── Intake & demand management ───────────────────────────────────────────────
// The front door: stakeholders (workspace members or, more commonly, external
// requesters with no login) submit a request; the ID team scores it (impact vs.
// effort) and, once approved, it converts into a real Project.
model IntakeRequest {
  id          String @id @default(cuid())
  workspaceId String
  number      Int // sequential per workspace; "REQ-<number>" is display-only

  requesterName  String
  requesterEmail String
  requestedById  String? // set only if a logged-in Member submitted it

  title          String
  description    String
  targetAudience String?
  targetDate     DateTime?

  impactScore Int? // 1-5, null until triaged
  effortScore Int? // 1-5, null until triaged

  status             String  @default("submitted") // submitted / triaging / approved / rejected / converted
  assignedToId       String?
  rejectionReason    String?
  convertedProjectId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy      User?     @relation("IntakeRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedTo       User?     @relation("IntakeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedProject Project?  @relation(fields: [convertedProjectId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

// ── Storyboarding (Phase 3) ──────────────────────────────────────────────────
// A storyboard is workspace-scoped (like a Board) and may optionally be linked to
// a project Deliverable of type "storyboard". It holds an ordered list of Screens.

model Storyboard {
  id            String            @id @default(cuid())
  workspaceId   String
  deliverableId String?           @unique
  title         String
  description   String?
  status        String            @default("draft") // draft / in_review / approved
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliverable   Deliverable?      @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  screens       Screen[]
  groupAccess   StoryboardGroup[]
  whiteboards   Whiteboard[]

  @@index([workspaceId])
}

model Screen {
  id               String            @id @default(cuid())
  storyboardId     String
  title            String
  screenType       String            @default("content") // intro / content / video / knowledge_check / interaction / assessment / summary
  position         String
  onScreenText     String? // TipTap document, stored as JSON string
  narration        String? // TipTap document — voiceover / audio script
  visualNotes      String? // TipTap document — visuals, media, layout
  interactionNotes String? // TipTap document — interactions, branching, programming
  developerNotes   String? // TipTap document — production / developer notes
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  storyboard       Storyboard        @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  objectives       ScreenObjective[]

  @@index([storyboardId, position])
}

// ── Learning objectives & the alignment spine ─────────────────────────────────
// Objectives belong to a project. Screens "teach" them (ScreenObjective) and
// assessment items "assess" them (AssessmentItemObjective) — giving a coverage /
// gap view over the ID's craft: objective → content → assessment.

model LearningObjective {
  id          String                    @id @default(cuid())
  projectId   String
  text        String
  bloomLevel  String                    @default("understand") // remember/understand/apply/analyze/evaluate/create
  position    String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  screens     ScreenObjective[]
  assessments AssessmentItemObjective[]

  @@index([projectId, position])
}

model ScreenObjective {
  screenId    String
  objectiveId String
  screen      Screen            @relation(fields: [screenId], references: [id], onDelete: Cascade)
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@id([screenId, objectiveId])
  @@index([objectiveId])
}

model AssessmentItem {
  id         String                    @id @default(cuid())
  projectId  String
  prompt     String
  itemType   String                    @default("multiple_choice") // multiple_choice/true_false/short_answer/scenario/other
  position   String
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  project    Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objectives AssessmentItemObjective[]

  @@index([projectId, position])
}

model AssessmentItemObjective {
  itemId      String
  objectiveId String
  item        AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@id([itemId, objectiveId])
  @@index([objectiveId])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

model Label {
  id      String      @id @default(cuid())
  boardId String
  name    String
  color   String // hex like "#ef4444"
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   CardLabel[]

  @@index([boardId])
}

model CardLabel {
  cardId  String
  labelId String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model CardAssignee {
  cardId String
  userId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

// ── Groups & access control ──────────────────────────────────────────────────
// A Group is a named set of workspace members. Access is DEFAULT-OPEN: a board /
// storyboard / project is visible to every workspace member UNTIL it is shared
// with one or more groups, after which only members of those groups (plus
// workspace ADMINs, who always have access) can see it. See src/lib/authz.ts.

model Group {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     GroupMembership[]
  boards      BoardGroup[]
  storyboards StoryboardGroup[]
  projects    ProjectGroup[]
  whiteboards WhiteboardGroup[]
  courses     CourseGroup[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model GroupMembership {
  groupId String
  userId  String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// Resource ↔ group access grants. Presence of any row restricts the resource to
// the granted groups; absence of rows leaves it open to all workspace members.

model BoardGroup {
  boardId String
  groupId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([boardId, groupId])
  @@index([groupId])
}

model StoryboardGroup {
  storyboardId String
  groupId      String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([storyboardId, groupId])
  @@index([groupId])
}

model ProjectGroup {
  projectId String
  groupId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([projectId, groupId])
  @@index([groupId])
}

// ── Whiteboards ──────────────────────────────────────────────────────────────
// A collaborative sketch canvas (Excalidraw). Workspace-scoped like a Board, may
// optionally be linked to a Storyboard. `scene` holds the serialized Excalidraw
// document (elements + files + a little appState) as a JSON string. Persisted /
// autosaved (last-write-wins); realtime multi-cursor is a future addition.

model Whiteboard {
  id           String            @id @default(cuid())
  workspaceId  String
  storyboardId String?
  cardId       String?
  createdById  String? // the ID who created/owns it
  title        String
  scene        String? // Excalidraw scene JSON
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storyboard   Storyboard?       @relation(fields: [storyboardId], references: [id], onDelete: SetNull)
  card         Card?             @relation(fields: [cardId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  groupAccess  WhiteboardGroup[]

  @@index([workspaceId])
  @@index([storyboardId])
  @@index([cardId])
  @@index([createdById])
}

model WhiteboardGroup {
  whiteboardId String
  groupId      String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([whiteboardId, groupId])
  @@index([groupId])
}

// ── Course authoring (block-based, Rise-style) ───────────────────────────────
// A Course is a stack of Lessons, each a stack of Blocks. A Block stores its
// type + a JSON `content` blob (flexible per type). Learner-view rendering is
// self-contained so it can later be packaged to SCORM / xAPI for an LMS.

model Course {
  id            String        @id @default(cuid())
  workspaceId   String
  deliverableId String?       @unique
  title         String
  description   String?
  status        String        @default("draft") // draft / published
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliverable   Deliverable?  @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  lessons       Lesson[]
  sections      Section[]
  groupAccess   CourseGroup[]

  @@index([workspaceId])
}

// A lightweight, optional grouping layer above lessons (Rise calls these
// "sections"). Lessons with no sectionId render as a flat list — the default,
// unchanged look for every course that hasn't opted into grouping.
model Section {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId, position])
}

model CourseGroup {
  courseId String
  groupId  String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([courseId, groupId])
  @@index([groupId])
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  sectionId String?
  title     String
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  blocks    Block[]

  @@index([courseId, position])
  @@index([sectionId])
}

model Block {
  id        String   @id @default(cuid())
  lessonId  String
  blockType String // heading / text / statement / image / divider / accordion / knowledge_check
  content   String   @default("{}") // JSON blob, shape depends on blockType
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
}
