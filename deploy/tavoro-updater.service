# Tavoro self-update agent. Install on the VM:
#   sudo cp deploy/tavoro-updater.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tavoro-updater
[Unit]
Description=Tavoro self-update agent
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and the paths to where the repo is checked out (a systemd drop-in works too).
User=tavoro
WorkingDirectory=/home/tavoro/tavoro
Environment=TAVORO_REPO=/home/tavoro/tavoro
ExecStart=/bin/bash /home/tavoro/tavoro/deploy/update-agent.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
